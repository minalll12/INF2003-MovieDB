# MySQL - local defaults; copy to .env only if .env does not already exist.
# Railway: use your public TCP endpoint and restricted app user's credentials.
# Keep actual connection values only in .env or the process environment.
DB_HOST=localhost
DB_PORT=3307
DB_USER=your_mysql_user
DB_PASSWORD='replace_with_your_mysql_password'
DB_NAME=movie_platform

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=movie_platform
